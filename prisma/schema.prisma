generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Rsvp {
  id              String   @id @default(uuid())
  fullName        String   @map("full_name")
  companionsCount Int      @default(0) @map("companions_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("rsvps")
}


model Gift {
  id        String  @id @default(uuid())
  title     String

  buyUrl    String? @map("buy_url")
  imagePath String? @map("image_path") // <- si tu columna es image_path

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  reservations GiftReservation[]

  @@map("gifts")
}


model GiftReservation {
  id             String   @id @default(uuid())
  giftId         String   @map("gift_id")
  reservedByName String   @map("reserved_by_name")
  reservedAt     DateTime @default(now()) @map("reserved_at")
  cancelledAt    DateTime? @map("cancelled_at")

  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@index([giftId, reservedAt])
  @@map("gift_reservations")
}
